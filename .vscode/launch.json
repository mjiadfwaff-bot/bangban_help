{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HotGo Server (Hot Reload)",
      "type": "node-terminal",
      "request": "launch",
      "command": "make all",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "HotGo Web (Hot Reload)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "name": "HotGo Full Stack (Hot Reload)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd server && make all & cd ../web && pnpm dev'",
      "cwd": "${workspaceFolder}"
    }
  ]
}
